<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="DockGx.DockWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:DockGx.Models"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls">

    <!-- The window itself is the glass: the acrylic backdrop paints this whole surface
         and DWM rounds its corners. Pinned to Dark so it always reads like the Win11
         dark taskbar (no light/white background). -->
    <Grid x:Name="RootGrid" Background="Transparent" RequestedTheme="Dark">
        <Border x:Name="DockStrip"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="Transparent"
                CornerRadius="10"
                Padding="8,6">

            <StackPanel x:Name="Strip"
                        Orientation="Horizontal"
                        Spacing="4"
                        VerticalAlignment="Center">

                <muxc:ItemsRepeater x:Name="ItemsHost">
                    <muxc:ItemsRepeater.Layout>
                        <muxc:StackLayout Orientation="Horizontal" Spacing="4" />
                    </muxc:ItemsRepeater.Layout>

                    <muxc:ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="models:DockItem">
                            <Grid x:Name="ItemRoot"
                                  Width="40"
                                  Height="40"
                                  Background="Transparent"
                                  RenderTransformOrigin="0.5,1.0"
                                  ToolTipService.ToolTip="{x:Bind DisplayName, Mode=OneWay}"
                                  PointerEntered="Item_PointerEntered"
                                  PointerExited="Item_PointerExited"
                                  Tapped="Item_Tapped"
                                  PointerReleased="Item_PointerReleased"
                                  RightTapped="Item_RightTapped">
                                <Grid.RenderTransform>
                                    <CompositeTransform />
                                </Grid.RenderTransform>

                                <Border x:Name="HoverPill"
                                        CornerRadius="8"
                                        Opacity="0"
                                        Background="{ThemeResource SubtleFillColorSecondaryBrush}" />

                                <Image Source="{x:Bind IconImage, Mode=OneWay}"
                                       Visibility="{x:Bind ImageVisibility, Mode=OneWay}"
                                       Width="24"
                                       Height="24"
                                       Stretch="Uniform" />

                                <FontIcon Glyph="{x:Bind Glyph}"
                                          Visibility="{x:Bind GlyphVisibility, Mode=OneWay}"
                                          FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                          FontSize="18"
                                          Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                            </Grid>
                        </DataTemplate>
                    </muxc:ItemsRepeater.ItemTemplate>
                </muxc:ItemsRepeater>

                <!-- Divider between user items and the settings button -->
                <Rectangle x:Name="Divider"
                           Width="1"
                           Height="24"
                           Fill="{ThemeResource TextFillColorPrimaryBrush}"
                           Opacity="0.15" />

                <!-- Settings (gear) button -->
                <Grid x:Name="SettingsButton"
                      Width="40"
                      Height="40"
                      Background="Transparent"
                      RenderTransformOrigin="0.5,1.0"
                      ToolTipService.ToolTip="Dock settings"
                      PointerEntered="Item_PointerEntered"
                      PointerExited="Item_PointerExited"
                      PointerReleased="Settings_PointerReleased">
                    <Grid.RenderTransform>
                        <CompositeTransform />
                    </Grid.RenderTransform>
                    <Border CornerRadius="8" Opacity="0"
                            Background="{ThemeResource SubtleFillColorSecondaryBrush}" />
                    <FontIcon Glyph="&#xE713;"
                              FontFamily="{ThemeResource SymbolThemeFontFamily}"
                              FontSize="18"
                              Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</Window>
