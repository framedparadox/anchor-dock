<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="DockGx.DockWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:DockGx.Models"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls">

    <!-- The window itself is the glass: the acrylic backdrop paints this whole surface
         and DWM rounds its corners. Pinned to Dark so it always reads like the Win11
         dark taskbar (no light/white background). Under a High Contrast theme the
         code-behind resets this to ElementTheme.Default and paints an opaque system
         background so the shell's high-contrast colors come through instead. -->
    <Grid x:Name="RootGrid" Background="Transparent" RequestedTheme="Dark">
        <Border x:Name="DockStrip"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="Transparent"
                CornerRadius="10"
                Padding="8,6">

            <StackPanel x:Name="Strip"
                        Orientation="Horizontal"
                        Spacing="4"
                        VerticalAlignment="Center"
                        XYFocusKeyboardNavigation="Enabled">

                <!-- Empty-state affordance: when the dock has no (visible) items this "+ Add New"
                     pill is shown in their place. Clicking it opens the Add-to-Dock window. -->
                <Button x:Name="AddNewButton"
                        Height="40"
                        MinWidth="0"
                        MinHeight="0"
                        Padding="12,0"
                        Visibility="Collapsed"
                        Background="Transparent"
                        BorderThickness="0"
                        CornerRadius="8"
                        AutomationProperties.Name="Add new dock item"
                        ToolTipService.ToolTip="Add an app, file, folder or link"
                        Click="AddNew_Click">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE710;"
                                  FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                  FontSize="16"
                                  Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                        <TextBlock Text="Add New"
                                   VerticalAlignment="Center"
                                   Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                    </StackPanel>
                </Button>

                <muxc:ItemsRepeater x:Name="ItemsHost">
                    <muxc:ItemsRepeater.Layout>
                        <muxc:StackLayout Orientation="Horizontal" Spacing="4" />
                    </muxc:ItemsRepeater.Layout>

                    <!-- Each item is a real Button: keyboard-focusable, Space/Enter invoke,
                         focus visuals, hover/pressed states, and an Invoke automation pattern
                         come from the platform for free. AutomationProperties.Name is what
                         Narrator announces; the icon visuals are marked Raw so they are not
                         announced separately. -->
                    <muxc:ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="models:DockItem">
                            <Button Width="40"
                                    Height="40"
                                    MinWidth="0"
                                    MinHeight="0"
                                    Padding="0"
                                    HorizontalContentAlignment="Center"
                                    VerticalContentAlignment="Center"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    CornerRadius="8"
                                    Tag="{x:Bind}"
                                    AutomationProperties.Name="{x:Bind DisplayName, Mode=OneWay}"
                                    ToolTipService.ToolTip="{x:Bind DisplayName, Mode=OneWay}"
                                    Click="Item_Click"
                                    ContextRequested="Item_ContextRequested">
                                <Grid>
                                    <Image Source="{x:Bind IconImage, Mode=OneWay}"
                                           Visibility="{x:Bind ImageVisibility, Mode=OneWay}"
                                           Width="24"
                                           Height="24"
                                           Stretch="Uniform"
                                           AutomationProperties.AccessibilityView="Raw" />

                                    <FontIcon Glyph="{x:Bind Glyph}"
                                              Visibility="{x:Bind GlyphVisibility, Mode=OneWay}"
                                              FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                              FontSize="18"
                                              Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                              AutomationProperties.AccessibilityView="Raw" />
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </muxc:ItemsRepeater.ItemTemplate>
                </muxc:ItemsRepeater>

                <!-- Divider between user items and the settings button (decorative:
                     hidden from assistive technology). -->
                <Rectangle x:Name="Divider"
                           Width="1"
                           Height="24"
                           Fill="{ThemeResource TextFillColorPrimaryBrush}"
                           Opacity="0.15"
                           AutomationProperties.AccessibilityView="Raw" />

                <!-- Settings (gear) button -->
                <Button x:Name="SettingsButton"
                        Width="40"
                        Height="40"
                        MinWidth="0"
                        MinHeight="0"
                        Padding="0"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center"
                        Background="Transparent"
                        BorderThickness="0"
                        CornerRadius="8"
                        AutomationProperties.Name="Dock settings"
                        ToolTipService.ToolTip="Dock settings"
                        Click="Settings_Click">
                    <FontIcon Glyph="&#xE713;"
                              FontFamily="{ThemeResource SymbolThemeFontFamily}"
                              FontSize="18"
                              Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                              AutomationProperties.AccessibilityView="Raw" />
                </Button>
            </StackPanel>
        </Border>

        <!-- Hidden-state notch. When the dock is snapped and auto-hidden it slides off the
             screen leaving only a thin peek; this rounded "handle" pokes into that peek band
             so the hidden dock is easy to find and pull back out. Its alignment is flipped to
             the correct edge in code (see DockWindow.AutoHide.cs). -->
        <Border x:Name="Notch"
                Visibility="Collapsed"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Width="64"
                Height="10"
                CornerRadius="5"
                Background="{ThemeResource AccentFillColorDefaultBrush}"
                Opacity="0.9"
                IsHitTestVisible="False"
                AutomationProperties.AccessibilityView="Raw" />
    </Grid>
</Window>
