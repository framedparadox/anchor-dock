<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="DockGx.AddNewWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Custom title bar: extended into so the Mica backdrop flows edge-to-edge and the
             caption matches a native Windows 11 window (no opaque white strip). -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Height="40" Background="Transparent">
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center"
                        Margin="14,0,0,0">
                <FontIcon Glyph="&#xE710;" FontFamily="{ThemeResource SymbolThemeFontFamily}"
                          FontSize="14" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                <TextBlock Text="Add to Dock" Style="{ThemeResource CaptionTextBlockStyle}"
                           VerticalAlignment="Center" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Padding="24,8,24,24" RowSpacing="18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Hero -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="14">
                <Border Width="44" Height="44" CornerRadius="10"
                        Background="{ThemeResource AccentFillColorDefaultBrush}">
                    <FontIcon Glyph="&#xE710;" FontFamily="{ThemeResource SymbolThemeFontFamily}"
                              FontSize="22" Foreground="White" />
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Add to Dock" Style="{ThemeResource TitleTextBlockStyle}" />
                    <TextBlock Text="Add an app, file, folder, link or shortcut."
                               Style="{ThemeResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </StackPanel>

            <!-- Type selector -->
            <StackPanel Grid.Row="1" Spacing="8">
                <TextBlock Text="What are you adding?" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <ToggleButton x:Name="AppType" Click="TypeSelected" Width="94" Height="76" Padding="0"
                                  HorizontalContentAlignment="Center"
                                  AutomationProperties.Name="App">
                        <StackPanel Spacing="6" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE71D;" FontFamily="{ThemeResource SymbolThemeFontFamily}" FontSize="22"
                                      AutomationProperties.AccessibilityView="Raw" />
                            <TextBlock Text="App" HorizontalAlignment="Center"
                                       AutomationProperties.AccessibilityView="Raw" />
                        </StackPanel>
                    </ToggleButton>
                    <ToggleButton x:Name="FileType" Click="TypeSelected" Width="94" Height="76" Padding="0"
                                  HorizontalContentAlignment="Center"
                                  AutomationProperties.Name="File">
                        <StackPanel Spacing="6" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE8A5;" FontFamily="{ThemeResource SymbolThemeFontFamily}" FontSize="22"
                                      AutomationProperties.AccessibilityView="Raw" />
                            <TextBlock Text="File" HorizontalAlignment="Center"
                                       AutomationProperties.AccessibilityView="Raw" />
                        </StackPanel>
                    </ToggleButton>
                    <ToggleButton x:Name="FolderType" Click="TypeSelected" Width="94" Height="76" Padding="0"
                                  HorizontalContentAlignment="Center"
                                  AutomationProperties.Name="Folder">
                        <StackPanel Spacing="6" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE8B7;" FontFamily="{ThemeResource SymbolThemeFontFamily}" FontSize="22"
                                      AutomationProperties.AccessibilityView="Raw" />
                            <TextBlock Text="Folder" HorizontalAlignment="Center"
                                       AutomationProperties.AccessibilityView="Raw" />
                        </StackPanel>
                    </ToggleButton>
                    <ToggleButton x:Name="LinkType" Click="TypeSelected" Width="94" Height="76" Padding="0"
                                  HorizontalContentAlignment="Center"
                                  AutomationProperties.Name="Web Link">
                        <StackPanel Spacing="6" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE71B;" FontFamily="{ThemeResource SymbolThemeFontFamily}" FontSize="22"
                                      AutomationProperties.AccessibilityView="Raw" />
                            <TextBlock Text="Web Link" HorizontalAlignment="Center"
                                       AutomationProperties.AccessibilityView="Raw" />
                        </StackPanel>
                    </ToggleButton>
                    <ToggleButton x:Name="ShortcutType" Click="TypeSelected" Width="94" Height="76" Padding="0"
                                  HorizontalContentAlignment="Center"
                                  AutomationProperties.Name="Shortcut">
                        <StackPanel Spacing="6" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE8A7;" FontFamily="{ThemeResource SymbolThemeFontFamily}" FontSize="22"
                                      AutomationProperties.AccessibilityView="Raw" />
                            <TextBlock Text="Shortcut" HorizontalAlignment="Center"
                                       AutomationProperties.AccessibilityView="Raw" />
                        </StackPanel>
                    </ToggleButton>
                </StackPanel>
            </StackPanel>

            <!-- Form -->
            <StackPanel Grid.Row="2" Spacing="14" VerticalAlignment="Top">
                <StackPanel Spacing="6">
                    <TextBlock x:Name="TargetLabel" Text="Target" />
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="TargetBox" Grid.Column="0"
                                 PlaceholderText="Choose or type a target…"
                                 TextChanged="TargetBox_TextChanged" />
                        <Button x:Name="BrowseButton" Grid.Column="1" Content="Browse…"
                                Click="Browse_Click" />
                    </Grid>
                    <TextBlock x:Name="TargetHint"
                               Style="{ThemeResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap" />
                </StackPanel>

                <StackPanel Spacing="6">
                    <TextBlock Text="Display name" />
                    <TextBox x:Name="NameBox" PlaceholderText="Shown in the dock tooltip" />
                </StackPanel>

                <StackPanel x:Name="ArgsPanel" Spacing="6">
                    <TextBlock Text="Arguments (optional)" />
                    <TextBox x:Name="ArgsBox" PlaceholderText="Command-line arguments" />
                </StackPanel>

                <InfoBar x:Name="ErrorBar" Severity="Error" IsOpen="False" IsClosable="False" />
            </StackPanel>

            <!-- Footer -->
            <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="8"
                        HorizontalAlignment="Right">
                <Button Content="Cancel" MinWidth="96" Click="Cancel_Click">
                    <Button.KeyboardAccelerators>
                        <KeyboardAccelerator Key="Escape" />
                    </Button.KeyboardAccelerators>
                </Button>
                <Button x:Name="AddButton" Content="Add to Dock" MinWidth="120"
                        Style="{ThemeResource AccentButtonStyle}" Click="Add_Click" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
