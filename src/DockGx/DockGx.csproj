<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>DockGx</RootNamespace>
    <AssemblyName>DockGx</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>

    <!-- WinUI apps cannot be AnyCPU; this machine is x64. -->
    <Platforms>x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>

    <UseWinUI>true</UseWinUI>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ImplicitUsings>enable</ImplicitUsings>

    <!-- Unpackaged (no MSIX) so it runs like a normal desktop utility. -->
    <WindowsPackageType>None</WindowsPackageType>
    <!-- Self-contained so no separate Windows App Runtime install is required. -->
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>

    <DefaultLanguage>en-US</DefaultLanguage>
    <EnableDefaultCssItems>false</EnableDefaultCssItems>

    <!-- App identity metadata: shows up in the exe's Details tab, Task Manager, and is required
         for a real Store/installer submission (see docs/microsoft-store-deployment.md).
         An <ApplicationIcon> is still needed for a shipping build; adding one requires an actual
         .ico asset, tracked as a follow-up (recommendation #13 in
         docs/design-guidelines-review.md). -->
    <Product>DockGx</Product>
    <Company>DockGx</Company>
    <Authors>DockGx</Authors>
    <Description>A floating dock for Windows 11.</Description>
    <Version>1.0.0.0</Version>
    <FileVersion>1.0.0.0</FileVersion>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <NeutralLanguage>en-US</NeutralLanguage>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.260317003" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.6901" />
    <PackageReference Include="System.Drawing.Common" Version="10.0.10" />
  </ItemGroup>

</Project>
