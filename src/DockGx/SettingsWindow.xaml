<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="DockGx.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls">

    <!-- NOTE: WinUI 3's Window is not a FrameworkElement and has no Resources property, so
         shared resources live on the root Grid, not on <Window.Resources>. -->
    <Grid>
        <Grid.Resources>
            <Style x:Key="Card" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="16,14" />
            </Style>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Custom title bar: extended into so the Mica backdrop flows edge-to-edge and the
             caption matches a native Windows 11 window (no opaque white strip). -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Height="40" Background="Transparent">
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center"
                        Margin="14,0,0,0">
                <FontIcon Glyph="&#xE713;" FontFamily="{ThemeResource SymbolThemeFontFamily}"
                          FontSize="14" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                <TextBlock Text="DockGx Settings" Style="{ThemeResource CaptionTextBlockStyle}"
                           VerticalAlignment="Center" />
            </StackPanel>
        </Grid>

        <muxc:NavigationView x:Name="Nav"
                             Grid.Row="1"
                             IsSettingsVisible="False"
                             IsBackButtonVisible="Collapsed"
                             IsTitleBarAutoPaddingEnabled="False"
                             PaneDisplayMode="Left"
                             OpenPaneLength="200"
                             SelectionChanged="Nav_SelectionChanged">
            <muxc:NavigationView.MenuItems>
                <muxc:NavigationViewItem x:Name="GeneralNav" Content="General" IsSelected="True"
                                         Icon="Setting" Tag="general" />
                <muxc:NavigationViewItem x:Name="AppsNav" Content="Apps &amp; links"
                                         Icon="AllApps" Tag="apps" />
                <muxc:NavigationViewItem x:Name="AboutNav" Content="About"
                                         Icon="Help" Tag="about" />
            </muxc:NavigationView.MenuItems>

            <Grid Padding="32,24,32,24">
                <!-- ==================== GENERAL ==================== -->
                <ScrollViewer x:Name="GeneralPanel">
                    <StackPanel Spacing="6" MaxWidth="720" HorizontalAlignment="Left">
                        <TextBlock Text="General" Style="{ThemeResource TitleTextBlockStyle}"
                                   Margin="0,0,0,12" />

                        <!-- Position -->
                        <Border Style="{StaticResource Card}">
                            <StackPanel Spacing="10">
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <FontIcon Glyph="&#xE7C4;" FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                              FontSize="18" VerticalAlignment="Top" Margin="0,2,0,0" />
                                    <StackPanel>
                                        <TextBlock Text="Dock position" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                        <TextBlock Text="Float freely, or snap flush to a screen edge."
                                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                </StackPanel>
                                <ComboBox x:Name="EdgeChoice" MinWidth="240"
                                          Header="Snap the dock to"
                                          SelectionChanged="EdgeChoice_SelectionChanged">
                                    <ComboBoxItem Content="Floating (don't snap)" />
                                    <ComboBoxItem Content="Bottom edge" />
                                    <ComboBoxItem Content="Top edge" />
                                    <ComboBoxItem Content="Left edge" />
                                    <ComboBoxItem Content="Right edge" />
                                </ComboBox>
                            </StackPanel>
                        </Border>

                        <!-- Auto-hide -->
                        <Border Style="{StaticResource Card}">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Grid.Column="0" Glyph="&#xE7C4;"
                                          FontFamily="{ThemeResource SymbolThemeFontFamily}" FontSize="18" />
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Auto-hide when snapped" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                    <TextBlock Text="Slide behind the edge and reveal on hover. A notch marks where it is."
                                               Style="{ThemeResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                                <ToggleSwitch x:Name="AutoHideSwitch" Grid.Column="2"
                                              OnContent="" OffContent="" MinWidth="0"
                                              HorizontalAlignment="Right"
                                              AutomationProperties.Name="Auto-hide when snapped"
                                              Toggled="AutoHideSwitch_Toggled" />
                            </Grid>
                        </Border>

                        <!-- Always on top -->
                        <Border Style="{StaticResource Card}">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Grid.Column="0" Glyph="&#xE840;"
                                          FontFamily="{ThemeResource SymbolThemeFontFamily}" FontSize="18" />
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Always on top" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                    <TextBlock Text="Keep the dock above other windows while it's floating. (When snapped it's always on top.)"
                                               Style="{ThemeResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                                <ToggleSwitch x:Name="AlwaysOnTopSwitch" Grid.Column="2"
                                              OnContent="" OffContent="" MinWidth="0"
                                              HorizontalAlignment="Right"
                                              AutomationProperties.Name="Always on top"
                                              Toggled="AlwaysOnTopSwitch_Toggled" />
                            </Grid>
                        </Border>

                        <!-- Startup -->
                        <Border Style="{StaticResource Card}">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Grid.Column="0" Glyph="&#xE7E8;"
                                          FontFamily="{ThemeResource SymbolThemeFontFamily}" FontSize="18" />
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Start with Windows" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                    <TextBlock Text="Launch DockGx automatically when you sign in."
                                               Style="{ThemeResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                                <ToggleSwitch x:Name="StartupSwitch" Grid.Column="2"
                                              OnContent="" OffContent="" MinWidth="0"
                                              HorizontalAlignment="Right"
                                              AutomationProperties.Name="Start with Windows"
                                              Toggled="StartupSwitch_Toggled" />
                            </Grid>
                        </Border>

                        <!-- Maintenance -->
                        <Border Style="{StaticResource Card}">
                            <StackPanel Spacing="12">
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <FontIcon Glyph="&#xE777;" FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                              FontSize="18" VerticalAlignment="Top" Margin="0,2,0,0" />
                                    <StackPanel>
                                        <TextBlock Text="Maintenance" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                        <TextBlock Text="Restore the seeded dock, or close the app."
                                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button Content="Reset dock to defaults" Click="Reset_Click" />
                                    <Button Content="Quit DockGx" Click="Quit_Click" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- ==================== APPS ==================== -->
                <Grid x:Name="AppsPanel" Visibility="Collapsed" RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <TextBlock Text="Apps &amp; links" Style="{ThemeResource TitleTextBlockStyle}"
                                   VerticalAlignment="Center" />
                        <Button HorizontalAlignment="Right" Style="{ThemeResource AccentButtonStyle}"
                                AutomationProperties.Name="Add new" Click="AddNew_Click">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE710;" FontFamily="{ThemeResource SymbolThemeFontFamily}" FontSize="14" />
                                <TextBlock Text="Add new" />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <TextBlock Grid.Row="1"
                               Text="Turn an item off to hide it from the dock without deleting it."
                               Style="{ThemeResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                    <ScrollViewer Grid.Row="2" HorizontalContentAlignment="Stretch">
                        <StackPanel x:Name="AppsList" Spacing="8" HorizontalAlignment="Stretch" />
                    </ScrollViewer>
                </Grid>

                <!-- ==================== ABOUT ==================== -->
                <ScrollViewer x:Name="AboutPanel" Visibility="Collapsed">
                    <StackPanel Spacing="6" MaxWidth="760" HorizontalAlignment="Left">
                        <TextBlock Text="About" Style="{ThemeResource TitleTextBlockStyle}"
                                   Margin="0,0,0,12" />

                        <!-- Identity -->
                        <Border Style="{StaticResource Card}">
                            <StackPanel Orientation="Horizontal" Spacing="16">
                                <Border Width="56" Height="56" CornerRadius="12"
                                        Background="{ThemeResource AccentFillColorDefaultBrush}">
                                    <FontIcon Glyph="&#xE71D;" FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                              FontSize="28" Foreground="White" />
                                </Border>
                                <StackPanel VerticalAlignment="Center" Spacing="2">
                                    <TextBlock Text="DockGx" Style="{ThemeResource SubtitleTextBlockStyle}" />
                                    <TextBlock x:Name="VersionText" Text="Version 1.0"
                                               Style="{ThemeResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Text="A floating dock for Windows 11, built with WinUI 3."
                                               Style="{ThemeResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Privacy -->
                        <Border Style="{StaticResource Card}">
                            <StackPanel Spacing="12">
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <FontIcon Glyph="&#xE72E;" FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                              FontSize="18" VerticalAlignment="Top" Margin="0,2,0,0" />
                                    <StackPanel>
                                        <TextBlock Text="Privacy" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                        <TextBlock Text="What DockGx does and doesn't do with your data."
                                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                </StackPanel>

                                <StackPanel Spacing="10" Margin="30,0,0,0">
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="Runs entirely on your PC" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                        <TextBlock TextWrapping="Wrap"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                   Text="Your dock items, layout and settings are saved locally to %AppData%\DockGx and never leave your device." />
                                    </StackPanel>
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="Icons" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                        <TextBlock TextWrapping="Wrap"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                   Text="App, file and folder icons come from Windows. For a web link, DockGx fetches the website's icon (favicon) over the internet — first directly from the site, and only if that fails, from DuckDuckGo's icon service, which receives just the site's domain. Downloaded icons are cached under %AppData%\DockGx\IconCache." />
                                    </StackPanel>
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="No tracking" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                        <TextBlock TextWrapping="Wrap"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                   Text="No accounts, no telemetry, no analytics, no ads. Launching an item hands it to Windows exactly as double-clicking it in Explorer would." />
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </muxc:NavigationView>
    </Grid>
</Window>
