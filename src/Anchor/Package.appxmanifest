<?xml version="1.0" encoding="utf-8"?>
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap rescap">

  <!-- Name/Publisher are placeholders. Replace with the values from Partner Center ->
       Product management -> Product identity after reserving the app name (see
       docs/microsoft-store-deployment.md, section 3). PublisherDisplayName likewise. -->
  <Identity Name="44492ajaykontham.AnchorDock"
            Publisher="CN=93C75305-77D7-448E-B1C4-591A0E9665E1"
            Version="1.0.0.0" />

  <Properties>
    <DisplayName>Anchor Dock</DisplayName>
    <PublisherDisplayName>ajaykontham</PublisherDisplayName>
    <Logo>Images\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop"
                        MinVersion="10.0.17763.0"
                        MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-US" />
  </Resources>

  <Applications>
    <Application Id="App" Executable="Anchor.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="Anchor"
        Description="A floating dock for Windows 11."
        BackgroundColor="transparent"
        Square150x150Logo="Images\Square150x150Logo.png"
        Square44x44Logo="Images\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="Images\Wide310x150Logo.png"
                         Square71x71Logo="Images\Square71x71Logo.png"
                         Square310x310Logo="Images\Square310x310Logo.png" />
        <uap:SplashScreen Image="Images\SplashScreen.png" />
      </uap:VisualElements>
    </Application>
  </Applications>

  <Capabilities>
    <!-- runFullTrust: Anchor Dock is a Win32 desktop productivity app (a floating
         application dock/launcher for Windows 11). It requires runFullTrust because
         its core function is to launch arbitrary user-selected desktop applications,
         files, and web links from the dock via Win32 APIs (ShellExecute) in
         Services/Launcher.cs, which is not possible from an AppContainer-sandboxed
         UWP process. Without full trust, the app's primary purpose (a customizable
         launcher/dock) cannot function. -->
    <rescap:Capability Name="runFullTrust" />
    <!-- broadFileSystemAccess: users can pin arbitrary files, folders, and shortcuts
         from anywhere on their file system to the dock. To display an accurate icon
         for each pinned item (matching File Explorer), Services/IconService.cs reads
         shell icons for these user-chosen paths via WinRT StorageFile, which can
         reside anywhere on local or removable drives, not just the limited set of
         broker-accessible library folders. No files are read, modified, or
         transmitted; the capability is used only for icon retrieval on paths the
         user has explicitly added to their dock.
         Drop this only if IconService is refactored to Win32 icon extraction (SHGetFileInfo). -->
    <rescap:Capability Name="broadFileSystemAccess" />
  </Capabilities>
</Package>
