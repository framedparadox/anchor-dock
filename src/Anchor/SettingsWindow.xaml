<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Anchor.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="using:Anchor.Localization"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls">

    <!-- NOTE: WinUI 3's Window is not a FrameworkElement and has no Resources property, so
         shared resources live on the root Grid, not on <Window.Resources>. -->
    <Grid x:Name="RootGrid">
        <Grid.Resources>
            <Style x:Key="Card" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="16,14" />
            </Style>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Custom title bar: extended into so the Mica backdrop flows edge-to-edge and the
             caption matches a native Windows 11 window (no opaque white strip). -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Height="40" Background="Transparent">
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center"
                        Margin="14,0,0,0">
                <FontIcon Glyph="&#xE713;" FontFamily="{ThemeResource SymbolThemeFontFamily}"
                          FontSize="14" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                <TextBlock Text="{loc:Localize Key=Settings.Title}"
                           Style="{ThemeResource CaptionTextBlockStyle}"
                           VerticalAlignment="Center" />
            </StackPanel>
        </Grid>

        <muxc:NavigationView x:Name="Nav"
                             Grid.Row="1"
                             IsSettingsVisible="False"
                             IsBackButtonVisible="Collapsed"
                             IsTitleBarAutoPaddingEnabled="False"
                             PaneDisplayMode="Left"
                             OpenPaneLength="200"
                             SelectionChanged="Nav_SelectionChanged">
            <muxc:NavigationView.MenuItems>
                <muxc:NavigationViewItem x:Name="GeneralNav" Content="{loc:Localize Key=Nav.General}"
                                         IsSelected="True" Icon="Setting" Tag="general" />
                <muxc:NavigationViewItem x:Name="AppsNav" Content="{loc:Localize Key=Nav.Apps}"
                                         Icon="AllApps" Tag="apps" />
                <muxc:NavigationViewItem x:Name="AboutNav" Content="{loc:Localize Key=Nav.About}" Tag="about">
                    <muxc:NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE946;" FontFamily="{ThemeResource SymbolThemeFontFamily}" />
                    </muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>
            </muxc:NavigationView.MenuItems>

            <Grid Padding="32,24,32,24">
                <!-- ==================== GENERAL ==================== -->
                <ScrollViewer x:Name="GeneralPanel">
                    <StackPanel Spacing="6" MaxWidth="720" HorizontalAlignment="Left">
                        <TextBlock Text="{loc:Localize Key=Nav.General}"
                                   Style="{ThemeResource TitleTextBlockStyle}"
                                   Margin="0,0,0,12" />

                        <!-- Appearance / theme -->
                        <Border Style="{StaticResource Card}">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Grid.Column="0" Glyph="&#xE771;"
                                          FontFamily="{ThemeResource SymbolThemeFontFamily}" FontSize="18" />
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{loc:Localize Key=Settings.Theme}"
                                               Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                    <TextBlock Text="{loc:Localize Key=Settings.ThemeDesc}"
                                               Style="{ThemeResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                                <ComboBox x:Name="ThemeChoice" Grid.Column="2" MinWidth="170"
                                          VerticalAlignment="Center" HorizontalAlignment="Right"
                                          AutomationProperties.Name="{loc:Localize Key=Settings.Theme}"
                                          SelectionChanged="ThemeChoice_SelectionChanged">
                                    <ComboBoxItem Content="{loc:Localize Key=Theme.Light}" />
                                    <ComboBoxItem Content="{loc:Localize Key=Theme.Dark}" />
                                    <ComboBoxItem Content="{loc:Localize Key=Theme.System}" />
                                </ComboBox>
                            </Grid>
                        </Border>

                        <!-- Language. The list itself is built in code-behind from Loc.Available so
                             the languages Anchor ships are declared in exactly one place. -->
                        <Border Style="{StaticResource Card}">
                            <StackPanel Spacing="12">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Grid.Column="0" Glyph="&#xF2B7;"
                                              FontFamily="{ThemeResource SymbolThemeFontFamily}" FontSize="18" />
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{loc:Localize Key=Settings.Language}"
                                                   Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                        <TextBlock Text="{loc:Localize Key=Settings.LanguageDesc}"
                                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                    <ComboBox x:Name="LanguageChoice" Grid.Column="2" MinWidth="190"
                                              VerticalAlignment="Center" HorizontalAlignment="Right"
                                              AutomationProperties.Name="{loc:Localize Key=Settings.Language}"
                                              SelectionChanged="LanguageChoice_SelectionChanged" />
                                </Grid>

                                <muxc:InfoBar x:Name="RestartBar" IsOpen="False" IsClosable="False"
                                              Severity="Informational"
                                              Message="{loc:Localize Key=Settings.RestartPrompt}">
                                    <muxc:InfoBar.ActionButton>
                                        <Button Content="{loc:Localize Key=Settings.RestartNow}"
                                                Click="Restart_Click" />
                                    </muxc:InfoBar.ActionButton>
                                </muxc:InfoBar>
                            </StackPanel>
                        </Border>

                        <!-- Global keyboard shortcut -->
                        <Border Style="{StaticResource Card}">
                            <StackPanel Spacing="12">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Grid.Column="0" Glyph="&#xE765;"
                                              FontFamily="{ThemeResource SymbolThemeFontFamily}" FontSize="18" />
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{loc:Localize Key=Settings.Hotkey}"
                                                   Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                        <TextBlock Text="{loc:Localize Key=Settings.HotkeyDesc}"
                                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                    <!-- The on/off switch sits at the right edge of the card, in
                                         line with every other toggle on this page; the shortcut
                                         itself stacks underneath it, right-aligned to match. -->
                                    <StackPanel Grid.Column="2" Orientation="Vertical" Spacing="10"
                                                VerticalAlignment="Center" HorizontalAlignment="Right">
                                        <ToggleSwitch x:Name="HotkeySwitch"
                                                      OnContent="" OffContent="" MinWidth="0"
                                                      HorizontalAlignment="Right"
                                                      AutomationProperties.Name="{loc:Localize Key=Settings.Hotkey}"
                                                      Toggled="HotkeySwitch_Toggled" />
                                        <!-- Clicking arms capture; the next key press becomes the
                                             shortcut (see HotkeyButton_PreviewKeyDown). -->
                                        <Button x:Name="HotkeyButton" MinWidth="150"
                                                HorizontalAlignment="Right"
                                                Click="HotkeyButton_Click"
                                                PreviewKeyDown="HotkeyButton_PreviewKeyDown"
                                                LostFocus="HotkeyButton_LostFocus" />
                                    </StackPanel>
                                </Grid>

                                <muxc:InfoBar x:Name="HotkeyBar" IsOpen="False" IsClosable="False"
                                              Severity="Warning" />
                            </StackPanel>
                        </Border>

                        <!-- Position -->
                        <Border Style="{StaticResource Card}">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Grid.Column="0" Glyph="&#xE7C4;"
                                          FontFamily="{ThemeResource SymbolThemeFontFamily}" FontSize="18" />
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{loc:Localize Key=Settings.Position}"
                                               Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                    <TextBlock Text="{loc:Localize Key=Settings.PositionDesc}"
                                               Style="{ThemeResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                                <ComboBox x:Name="EdgeChoice" Grid.Column="2" MinWidth="190"
                                          VerticalAlignment="Center" HorizontalAlignment="Right"
                                          AutomationProperties.Name="{loc:Localize Key=Settings.Position}"
                                          SelectionChanged="EdgeChoice_SelectionChanged">
                                    <ComboBoxItem Content="{loc:Localize Key=Position.Floating}" />
                                    <ComboBoxItem Content="{loc:Localize Key=Position.Bottom}" />
                                    <ComboBoxItem Content="{loc:Localize Key=Position.Top}" />
                                    <ComboBoxItem Content="{loc:Localize Key=Position.Left}" />
                                    <ComboBoxItem Content="{loc:Localize Key=Position.Right}" />
                                </ComboBox>
                            </Grid>
                        </Border>

                        <!-- Snapping behaviour: vertical when snapped to a side edge -->
                        <Border Style="{StaticResource Card}">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Grid.Column="0" Glyph="&#xE7AD;"
                                          FontFamily="{ThemeResource SymbolThemeFontFamily}" FontSize="18" />
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{loc:Localize Key=Settings.Transpose}"
                                               Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                    <TextBlock Text="{loc:Localize Key=Settings.TransposeDesc}"
                                               Style="{ThemeResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                                <ToggleSwitch x:Name="VerticalSnapSwitch" Grid.Column="2"
                                              OnContent="" OffContent="" MinWidth="0"
                                              HorizontalAlignment="Right"
                                              AutomationProperties.Name="{loc:Localize Key=Settings.Transpose}"
                                              Toggled="VerticalSnapSwitch_Toggled" />
                            </Grid>
                        </Border>

                        <!-- Auto-hide -->
                        <Border Style="{StaticResource Card}">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Grid.Column="0" Glyph="&#xE7C4;"
                                          FontFamily="{ThemeResource SymbolThemeFontFamily}" FontSize="18" />
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{loc:Localize Key=Settings.AutoHide}"
                                               Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                    <TextBlock Text="{loc:Localize Key=Settings.AutoHideDesc}"
                                               Style="{ThemeResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                                <ToggleSwitch x:Name="AutoHideSwitch" Grid.Column="2"
                                              OnContent="" OffContent="" MinWidth="0"
                                              HorizontalAlignment="Right"
                                              AutomationProperties.Name="{loc:Localize Key=Settings.AutoHide}"
                                              Toggled="AutoHideSwitch_Toggled" />
                            </Grid>
                        </Border>

                        <!-- Always on top -->
                        <Border Style="{StaticResource Card}">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Grid.Column="0" Glyph="&#xE840;"
                                          FontFamily="{ThemeResource SymbolThemeFontFamily}" FontSize="18" />
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{loc:Localize Key=Settings.AlwaysOnTop}"
                                               Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                    <TextBlock Text="{loc:Localize Key=Settings.AlwaysOnTopDesc}"
                                               Style="{ThemeResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                                <ToggleSwitch x:Name="AlwaysOnTopSwitch" Grid.Column="2"
                                              OnContent="" OffContent="" MinWidth="0"
                                              HorizontalAlignment="Right"
                                              AutomationProperties.Name="{loc:Localize Key=Settings.AlwaysOnTop}"
                                              Toggled="AlwaysOnTopSwitch_Toggled" />
                            </Grid>
                        </Border>

                        <!-- Startup -->
                        <Border Style="{StaticResource Card}">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Grid.Column="0" Glyph="&#xE7E8;"
                                          FontFamily="{ThemeResource SymbolThemeFontFamily}" FontSize="18" />
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{loc:Localize Key=Settings.Startup}"
                                               Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                    <TextBlock Text="{loc:Localize Key=Settings.StartupDesc}"
                                               Style="{ThemeResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                                <ToggleSwitch x:Name="StartupSwitch" Grid.Column="2"
                                              OnContent="" OffContent="" MinWidth="0"
                                              HorizontalAlignment="Right"
                                              AutomationProperties.Name="{loc:Localize Key=Settings.Startup}"
                                              Toggled="StartupSwitch_Toggled" />
                            </Grid>
                        </Border>

                        <!-- Maintenance -->
                        <Border Style="{StaticResource Card}">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Grid.Column="0" Glyph="&#xE777;"
                                          FontFamily="{ThemeResource SymbolThemeFontFamily}" FontSize="18" />
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{loc:Localize Key=Settings.ResetSection}"
                                               Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                    <TextBlock Text="{loc:Localize Key=Settings.ResetSectionDesc}"
                                               Style="{ThemeResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                                <Button Grid.Column="2" Content="{loc:Localize Key=Settings.Reset}"
                                        VerticalAlignment="Center" HorizontalAlignment="Right"
                                        Click="Reset_Click" />
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- ==================== APPS ==================== -->
                <Grid x:Name="AppsPanel" Visibility="Collapsed" RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <TextBlock Text="{loc:Localize Key=Nav.Apps}"
                                   Style="{ThemeResource TitleTextBlockStyle}"
                                   VerticalAlignment="Center" />
                        <Button HorizontalAlignment="Right" Style="{ThemeResource AccentButtonStyle}"
                                AutomationProperties.Name="{loc:Localize Key=Apps.AddNew}" Click="AddNew_Click">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE710;" FontFamily="{ThemeResource SymbolThemeFontFamily}" FontSize="14" />
                                <TextBlock Text="{loc:Localize Key=Apps.AddNew}" />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <TextBlock Grid.Row="1"
                               Text="{loc:Localize Key=Apps.Hint}"
                               Style="{ThemeResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap" />

                    <ScrollViewer Grid.Row="2" HorizontalContentAlignment="Stretch">
                        <StackPanel x:Name="AppsList" Spacing="8" HorizontalAlignment="Stretch" />
                    </ScrollViewer>
                </Grid>

                <!-- ==================== ABOUT ==================== -->
                <ScrollViewer x:Name="AboutPanel" Visibility="Collapsed">
                    <!-- Stretch so the cards fill the page width whether or not the Privacy
                         expander is open (a Left-aligned panel would size to its content and
                         only widen once the long expanded text appears). -->
                    <StackPanel Spacing="6" HorizontalAlignment="Stretch">
                        <TextBlock Text="{loc:Localize Key=Nav.About}"
                                   Style="{ThemeResource TitleTextBlockStyle}"
                                   Margin="0,0,0,12" />

                        <!-- Identity + developer -->
                        <Border Style="{StaticResource Card}">
                            <StackPanel Spacing="12">
                                <StackPanel Orientation="Horizontal" Spacing="16">
                                    <!-- The real app logo, not a stand-in glyph. targetsize-256 is the
                                         largest unpadded variant, so it stays crisp at 56px. -->
                                    <Border Width="56" Height="56" CornerRadius="12">
                                        <Image Source="ms-appx:///Images/Square44x44Logo.targetsize-256.png"
                                               Width="56" Height="56" Stretch="UniformToFill" />
                                    </Border>
                                    <StackPanel VerticalAlignment="Center" Spacing="2">
                                        <TextBlock Text="Anchor" Style="{ThemeResource SubtitleTextBlockStyle}" />
                                        <TextBlock x:Name="VersionText"
                                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock Text="{loc:Localize Key=About.Tagline}"
                                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                </StackPanel>

                                <TextBlock TextWrapping="Wrap"
                                           Style="{ThemeResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           Text="{loc:Localize Key=About.Credits}" />

                                <!-- HyperlinkButton opens the URI with the default browser; no
                                     code-behind needed. Margin trims the button's built-in padding
                                     so the links line up with the text above. -->
                                <StackPanel Orientation="Horizontal" Spacing="4" Margin="-12,0,0,0">
                                    <HyperlinkButton Content="{loc:Localize Key=About.SourceCode}"
                                                     NavigateUri="https://github.com/framedparadox/anchor-dock" />
                                    <HyperlinkButton Content="{loc:Localize Key=About.ReportIssue}"
                                                     NavigateUri="https://github.com/framedparadox/anchor-dock/issues" />
                                    <HyperlinkButton Content="{loc:Localize Key=About.License}"
                                                     NavigateUri="https://github.com/framedparadox/anchor-dock/blob/main/LICENSE" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Privacy: collapsed by default; expand for the details. -->
                        <Expander HorizontalAlignment="Stretch"
                                  HorizontalContentAlignment="Stretch"
                                  IsExpanded="False">
                            <Expander.Header>
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <FontIcon Glyph="&#xE72E;" FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                              FontSize="18" VerticalAlignment="Center" />
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{loc:Localize Key=About.Privacy}"
                                                   Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                        <TextBlock Text="{loc:Localize Key=About.PrivacyDesc}"
                                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                </StackPanel>
                            </Expander.Header>
                            <StackPanel Spacing="12">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="{loc:Localize Key=About.PrivacyLocal}"
                                               Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                    <TextBlock TextWrapping="Wrap"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               Text="{loc:Localize Key=About.PrivacyLocalBody}" />
                                </StackPanel>
                                <StackPanel Spacing="2">
                                    <TextBlock Text="{loc:Localize Key=About.PrivacyIcons}"
                                               Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                    <TextBlock TextWrapping="Wrap"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               Text="{loc:Localize Key=About.PrivacyIconsBody}" />
                                </StackPanel>
                                <StackPanel Spacing="2">
                                    <TextBlock Text="{loc:Localize Key=About.PrivacyTracking}"
                                               Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                    <TextBlock TextWrapping="Wrap"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               Text="{loc:Localize Key=About.PrivacyTrackingBody}" />
                                </StackPanel>
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </muxc:NavigationView>
    </Grid>
</Window>
