<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>Anchor</RootNamespace>
    <AssemblyName>Anchor</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\Anchor.ico</ApplicationIcon>

    <!-- WinUI apps cannot be AnyCPU; this machine is x64. -->
    <Platforms>x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>

    <UseWinUI>true</UseWinUI>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ImplicitUsings>enable</ImplicitUsings>

    <!-- Unpackaged (no MSIX) so it runs like a normal desktop utility. -->
    <WindowsPackageType>None</WindowsPackageType>
    <!-- Self-contained so no separate Windows App Runtime install is required. -->
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>

    <DefaultLanguage>en-US</DefaultLanguage>
    <EnableDefaultCssItems>false</EnableDefaultCssItems>

    <!-- App identity metadata: shows up in the exe's Details tab, Task Manager, and is required
         for a real Store/installer submission (see docs/microsoft-store-deployment.md). -->
    <Product>Anchor</Product>
    <Company>Anchor</Company>
    <Authors>Anchor</Authors>
    <Description>A floating dock for Windows 11.</Description>
    <Version>1.0.0.0</Version>
    <FileVersion>1.0.0.0</FileVersion>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <NeutralLanguage>en-US</NeutralLanguage>
  </PropertyGroup>

  <!-- MSIX packaging for the Microsoft Store, built on demand with -p:StorePackage=true.
       Everyday `dotnet build`/`dotnet publish` stays unpackaged (see docs/microsoft-store-deployment.md). -->
  <PropertyGroup Condition="'$(StorePackage)' == 'true'">
    <WindowsPackageType>MSIX</WindowsPackageType>
    <EnableMsixTooling>true</EnableMsixTooling>
    <AppxPackageSigningEnabled>false</AppxPackageSigningEnabled>
    <GenerateAppInstallerFile>false</GenerateAppInstallerFile>
    <AppxBundle>Always</AppxBundle>
    <AppxAutoIncrementPackageRevision>false</AppxAutoIncrementPackageRevision>
    <WinAppSdkCheckForPdbConversion>false</WinAppSdkCheckForPdbConversion>
    <UapAppxPackageBuildMode>StoreUpload</UapAppxPackageBuildMode>
  </PropertyGroup>

  <ItemGroup Condition="'$(StorePackage)' == 'true'">
    <AppxManifest Include="Package.appxmanifest">
      <SubType>Designer</SubType>
    </AppxManifest>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.260317003" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.6901" />
    <PackageReference Include="System.Drawing.Common" Version="10.0.10" />
  </ItemGroup>

  <ItemGroup Condition="'$(StorePackage)' == 'true'">
    <Content Include="Images\**\*.png" />
  </ItemGroup>

</Project>
